# API auth — the business VPS sends this back as the X-API-Key header.
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OFF_SERVICE_API_KEY=

# Cloudflare Tunnel token (Cloudflare dashboard -> Zero Trust -> Networks -> Tunnels)
CLOUDFLARE_TUNNEL_TOKEN=

# In-container path — normally does not need to change (see docker-compose.yml's
# off-api volumes: ./data is bind-mounted here).
OFF_PARQUET_PATH=/app/data/openfoodfacts/food.parquet
OFF_LOOKUP_TIMEOUT_SECONDS=6.0
# Higher than the business VPS's old 128MB cap — this box has real RAM to spare.
OFF_LOOKUP_MEMORY_LIMIT_MB=512

# --- refresh/off-monthly-refresh.sh (host cron, not read by the API container) ---
# This box has real bandwidth/CPU to spare, so this is looser than the business
# VPS's old 3M throttle — still gentle enough not to hog a shared host's link.
OFF_REFRESH_RATE_LIMIT=10M
# Multi-threaded, generous cap — this is the one-off monthly export job, not the
# per-request lookup path, so it can use the box's real resources.
OFF_REFRESH_DUCKDB_MEMORY_MB=4096
# Where the finished catalog-latest.csv is published. Leave unset to default to
# ~/off-catalog — must stay under the appbox SFTP account's home since the
# business VPS pulls from there via the relative path "off-catalog/catalog-latest.csv".
OFF_CATALOG_PUBLISH_DIR=
